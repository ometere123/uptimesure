  "dependencies": {
    "@supabase/supabase-js": "2.56.1",
    "next": "16.3.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
